# Copy to .env for local dev (or set these in the real environment).

# lsscloud.com credentials — required
LIFESAVER_USERNAME=
LIFESAVER_PASSWORD=

# MCP server transport: stdio (local, default) | streamable-http (remote/Cloud Run)
# MCP_TRANSPORT=stdio

# Required when MCP_TRANSPORT=streamable-http — bearer token clients must send.
# Generate: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Optional (streamable-http): comma-separated Host/Origin allow-list. Set to the
# public hostname to enable DNS-rebinding protection; unset = allow any.
# MCP_ALLOWED_HOSTS=lifesaver-mcp-xxxx-uc.a.run.app

# Optional overrides:
# LIFESAVER_BASE_URL=https://lsscloud.com
# LIFESAVER_RSPROXY=http://lifesaver-sql1.corp.lifesaversoft.com/reportserver
# LIFESAVER_HTTP_TIMEOUT=120
# LIFESAVER_TERMINATE_OWN_SESSION=true
